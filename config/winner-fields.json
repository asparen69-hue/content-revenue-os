    { "key": "scoreEaseOfProduction", "label": "Produktionsaufwand / Umsetzbarkeit (1-10)", "type": "score", "group": "Scores", "help": "10 = sehr leicht umsetzbar (wenig Aufwand)." },
    { "key": "scoreMonetization", "label": "Monetarisierungspotenzial (1-10)", "type": "score", "group": "Scores" },
    { "key": "scoreEvidence", "label": "Evidenzstärke (1-10)", "type": "score", "group": "Scores" },
    { "key": "overallScore", "label": "Opportunity Score (0-100)", "type": "computed", "group": "Scores", "help": "Wird automatisch berechnet. Siehe Formel." },

    { "key": "ownVideoUrl", "label": "Unser Video (URL)", "type": "url", "group": "Ergebnis-Tracking", "help": "Nur gemessene Werte eintragen. Leer lassen, wenn unbekannt. Ein Test pro Winner." },
    { "key": "ownPlatform", "label": "Plattform (unser Video)", "type": "select", "group": "Ergebnis-Tracking",
      "options": ["Instagram", "TikTok", "YouTube Shorts", "YouTube", "Facebook", "LinkedIn", "Advertisement", "Other"],
      "optionLabels": { "Advertisement": "Werbeanzeige", "Other": "Sonstiges" } },
    { "key": "ownPublishDate", "label": "Veröffentlicht am", "type": "date", "group": "Ergebnis-Tracking" },
    { "key": "ownTrackingDate", "label": "Stand der Messung", "type": "date", "group": "Ergebnis-Tracking" },
    { "key": "ownViews", "label": "Aufrufe (unser Video)", "type": "number", "group": "Ergebnis-Tracking" },
    { "key": "ownAvgWatchPercent", "label": "Ø Wiedergabe in %", "type": "number", "group": "Ergebnis-Tracking", "help": "Ganze Zahl, z. B. 45." },
    { "key": "ownComments", "label": "Kommentare (unser Video)", "type": "number", "group": "Ergebnis-Tracking" },
    { "key": "ownShares", "label": "Shares (unser Video)", "type": "number", "group": "Ergebnis-Tracking" },
    { "key": "ownSaves", "label": "Speicherungen (unser Video)", "type": "number", "group": "Ergebnis-Tracking" },
    { "key": "ownKeywordComments", "label": "CTA-Kommentare (Schlüsselwort)", "type": "number", "group": "Ergebnis-Tracking" },
    { "key": "ownLeads", "label": "Leads", "type": "number", "group": "Ergebnis-Tracking" },
    { "key": "ownSales", "label": "Verkäufe", "type": "number", "group": "Ergebnis-Tracking" },
    { "key": "ownCosts", "label": "Kosten (€)", "type": "money", "group": "Ergebnis-Tracking", "help": "Hailuo, ElevenLabs, Werbung usw. Der Umsatz steht unter 'Erzielter Umsatz' bei Unser Test." },

    { "key": "status", "label": "Unser Status", "type": "select", "group": "Unser Test",
