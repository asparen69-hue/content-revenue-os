    { "key": "saves", "label": "Speicherungen", "type": "number", "group": "Performance" },
    { "key": "followers", "label": "Follower des Accounts (falls bekannt)", "type": "number", "group": "Performance" },

    { "key": "whyItWorked", "label": "Warum es vermutlich funktioniert", "type": "longtext", "group": "Analyse" },
    { "key": "reusableMechanism", "label": "Wiederverwendbarer Mechanismus", "type": "longtext", "group": "Analyse" },
    { "key": "evidenceStrength", "label": "Evidenzstärke", "type": "select", "group": "Analyse", "options": ["Strong", "Medium", "Weak"],
      "optionLabels": { "Strong": "Stark", "Medium": "Mittel", "Weak": "Schwach" } },
    { "key": "researchSource", "label": "Forschungsquelle", "type": "select", "group": "Analyse",
      "options": ["Manual", "Astra", "Claude Research", "ChatGPT", "Other"], "default": "Manual",
      "optionLabels": { "Manual": "Manuell", "Other": "Sonstiges" } },

    { "key": "scorePain", "label": "Schmerzintensität (1-10)", "type": "score", "group": "Scores" },
