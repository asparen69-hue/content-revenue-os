{
  "name": "Content Revenue OS - Winner Library",
  "schemaVersion": 2,
  "scoreFormula": "Opportunity Score (0-100) = Durchschnitt der ausgefüllten 1-10-Bewertungen (Schmerzintensität, Dringlichkeit, Kaufabsicht, Content-Potenzial, Differenzierung, Produktionsaufwand / Umsetzbarkeit, Monetarisierungspotenzial, Evidenzstärke) x 10, auf eine ganze Zahl gerundet. Alle 8 Kriterien zählen gleich. Leere Kriterien werden ignoriert; 'scoredCount' zeigt, wie viele der 8 ausgefüllt sind. Sind alle 8 leer, wird kein Score berechnet.",
  "groups": ["Grunddaten", "Hook & Einstieg", "Psychologie", "Funnel & Angebot", "Performance", "Analyse", "Scores", "Ergebnis-Tracking", "Unser Test"],
  "fields": [
    { "key": "title", "label": "Titel", "type": "text", "group": "Grunddaten", "required": true, "help": "Kurzer Name, an dem du den Eintrag später wiedererkennst." },
    { "key": "creator", "label": "Creator / Account", "type": "text", "group": "Grunddaten" },
    { "key": "platform", "label": "Plattform", "type": "select", "group": "Grunddaten",
      "options": ["Instagram", "TikTok", "YouTube Shorts", "YouTube", "Facebook", "LinkedIn", "Advertisement", "Other"],
      "optionLabels": { "Advertisement": "Werbeanzeige", "Other": "Sonstiges" } },
    { "key": "sourceUrl", "label": "Quell-URL", "type": "url", "group": "Grunddaten", "help": "Muss mit http:// oder https:// beginnen." },
    { "key": "dateDiscovered", "label": "Entdeckt am", "type": "date", "group": "Grunddaten", "default": "today" },
    { "key": "niche", "label": "Nische / Markt", "type": "text", "group": "Grunddaten" },
