      "optionLabels": { "Discovered": "Entdeckt", "Approved for test": "Für Tests freigegeben", "Testing": "Im Test", "Failed": "Gescheitert", "Archived": "Archiviert" } },
    { "key": "adaptationIdea", "label": "Unsere Adaptionsidee", "type": "longtext", "group": "Unser Test" },
    { "key": "testResult", "label": "Unser Testergebnis", "type": "longtext", "group": "Unser Test" },
    { "key": "revenueGenerated", "label": "Erzielter Umsatz", "type": "money", "group": "Unser Test", "help": "Nur echter Umsatz. Leer lassen, wenn unbekannt." },
    { "key": "notes", "label": "Notizen", "type": "longtext", "group": "Unser Test" }
